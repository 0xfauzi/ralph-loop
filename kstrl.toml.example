# kstrl configuration
# Copy to kstrl.toml and customize. All values shown are defaults.
# Environment variables override these settings (see README for mapping).

[agent]
type = ""                          # "claude-code" | "claude-sdk" | "codex" (empty = auto-detect)
command = ""                       # custom agent shell command; overrides type
model = ""                         # e.g., "sonnet" for claude, "gpt-5.5" for codex (empty = default)
reasoning_effort = ""              # low|medium|high|max
budget_usd = 0                     # in-loop USD ceiling; claude-sdk adapter only; 0 = unlimited (R7.6)

[run]
max_iterations = 10
sleep_seconds = 2
interactive = false

[paths]
prompt = "scripts/kstrl/prompt.md"
prd = "scripts/kstrl/prd.json"
# Left unset on purpose. Unset, each factory component's engineer writes
# progress.txt beside its own PRD (scripts/kstrl/feature/<id>/), which is
# inside the component's allowedPaths; `ks run` still uses
# scripts/kstrl/progress.txt. Setting this key FORCES one path on every
# component, and a path outside the component subtree fails Phase 1
# diff_scope.
# progress = "scripts/kstrl/progress.txt"
codebase_map = "scripts/kstrl/codebase_map.md"
allowed = []                       # e.g., ["scripts/kstrl/", "src/"]

[git]
branch = ""                        # override branch (empty = use PRD branchName)
auto_checkout = true

[ui]
ascii = false

# Timeout limits in seconds (R0.1). A value of 0 or less disables that limit.
[timeout]
git_operation = 30.0               # per git subprocess
agent_iteration = 1800.0           # one engineer iteration
component_total = 7200.0           # wall clock per component across iterations
verification_check = 300.0         # each Phase 1 check subprocess
review_agent = 600.0               # Phase 2 reviewer call
contract_test = 600.0              # Phase 3 contract test run
subprocess_default = 60.0          # any other subprocess
scheduler_backstop_margin = 60.0   # extra slack before the scheduler declares a worker dead

# No-progress circuit breaker (R7.5): halt the engineer loop loudly when N
# consecutive iterations produce an unchanged diff hash AND an unchanged
# test-failure signature (the community's most-repeated kstrl-loop fix).
# The stall probe only runs on iterations whose diff hash already matched;
# with no test_command the breaker is diff-hash only.
[breaker]
no_progress_iterations = 3         # consecutive no-progress iterations before the halt; 0 disables
test_command = ""                  # stall-probe command; empty = the explicit [verify] test_command
test_timeout = 300.0               # seconds before the stall probe is killed

# OS-level agent sandboxing (R7.5). Applies to the claude-code and codex
# adapters (a custom agent command has no generic sandbox surface and is
# refused loudly). Write scope is the agent's worktree by construction;
# allow_network re-opens outbound network inside the sandbox.
# Measured mappings (see kstrl/sandbox.py): codex gets
# --sandbox workspace-write + an explicit network_access override;
# claude gets --settings '{"sandbox": ...}' and, when network is denied,
# runs without --dangerously-skip-permissions (the domain allowlist is a
# permission-layer gate) with file tools re-allowed via settings.
[sandbox]
enabled = false                    # opt-in: sandboxing changes agent behavior
allow_network = false              # deny outbound network inside the sandbox

# Per-component semantic knowledge layer.
# A third memory surface (alongside .kstrl/evolution.jsonl and progress.txt)
# that captures durable facts about WHAT WAS BUILT: interfaces, invariants,
# contracts, gotchas. Written after Phase 2 review passes, read by
# downstream components automatically.
#
# Storage: .kstrl/knowledge/<component_id>/<run_id>/<fact_id>.md
# Latest run dir per component wins; contract-breaker retries naturally
# orphan stale facts.
#
# LLM-driven consolidation/rewriting of existing facts is intentionally
# NOT a tunable. This is a permanent design decision: atomic fact files
# plus latest-run-dir-wins gives audit history without the rewrite drift
# observed when LLMs are allowed to update memory in place.
[knowledge]
enabled = true
max_core_tokens = 2000             # current component's facts (full text)
max_dependency_tokens = 1000       # transitive deps' facts (full text)
max_sibling_tokens = 500           # other components' facts (first sentence only)
distill_timeout_seconds = 300
distill_model = ""                 # empty = falls back to [agent].model
max_facts_per_distill = 7
# E8: scope of the "Dependencies" full-text tier in build_knowledge_context.
# "direct" surfaces only Component.dependencies (the manifest's import surface);
# "transitive" walks the full closure. Transitive deps not in the full-text
# tier still appear in the sibling first-sentence summary tier.
dependency_scope = "direct"

# Factory orchestrator settings (Phase 0-3 pipeline coordination).
[factory]
max_parallel = 4                   # concurrent component workers
max_retries = 3                    # per-component retry budget across all phases
retry_delay = 5.0                  # seconds between retry attempts
use_worktrees = true               # branch each component into .kstrl/worktrees/<run>/<id>
single_pr = false                  # one PR for the whole factory vs per-component
create_prs = true                  # call `gh` to push + merge per component
review_mode = "hard"               # hard | advisory | skip
setpoint_agreement = "advisory"    # advisory | block
# A story is "done" when the engineer sets passes=true in the PRD - the
#   agent that did the work reporting on the work. This checks that claim
#   against the reviewer's per-story verdicts. "advisory" records a finding
#   and lets the component proceed; "block" also resets passes to false in
#   the PRD and retries the story. The autonomy ladder forces blocking from
#   L1 up; it can never turn it off.
merge_timeout = 300.0              # seconds to wait for PR merge confirmation (R0.2)
max_adversarial_calls = 0          # 0 = unbounded; otherwise cap review+security+distill calls per run
# At the cap a hard-mode review or security phase HALTS the component
#   (failed_check = adversarial_budget) rather than merging it on
#   mechanical checks alone; an advisory one skips, and can still fail
#   the component at the set-point gate. Budget 3 calls per component
#   for hard review + hard security + knowledge (docs/runbook.md).
max_total_tokens = 0               # run-level token budget; 0 = unbounded (R3.1/R8)
max_cost_usd = 0.0                 # run-level USD budget; 0 = unbounded (R8)
# Prefer max_cost_usd if what you mean is "do not spend more than $X".
#   MEASURED, not hypothetical: a real run halted on max_total_tokens = 500000
#   at 1,864,081 total tokens - 1,781,669 of them (95.6%) CACHE READS - having
#   spent $1.22. total_tokens counts cache reads at par with input tokens, and
#   cache reads cost roughly an order of magnitude less, so a token cap
#   measures something real but nearly uncorrelated with money.
#
# What EITHER ceiling actually guarantees (read this before trusting them):
#   Checked BETWEEN engineer iterations and at every phase boundary. Once the
#   run's reported spend reaches a configured ceiling, no NEW iteration and no
#   new phase starts, and the component halts loudly (budget_overrun inbox
#   item). Both may be set; whichever is reached first halts.
#   NEITHER is a hard cap - max_cost_usd has exactly the same limits as
#   max_total_tokens. What stays unbounded:
#     - the iteration already in flight: nothing interrupts a single agent call
#       mid-run, so overshoot is up to one iteration (bounded in wall clock by
#       [timeout] agent_iteration, not in tokens and not in dollars). Measured:
#       the run above overshot its entire 500k cap by 3.7x inside ONE engineer
#       call of 376s;
#     - concurrent workers: each one sees the run total as of ITS launch, so
#       with max_parallel = N the overshoot scales with N;
#     - unreported spend: every figure is a CLI self-report, so totals are
#       lower bounds whenever unreported_calls > 0. When THIS engineer loop
#       reports nothing a ceiling needs AND the run has now seen two such calls
#       (a custom agent_cmd never reports), that ceiling provably cannot trip.
#       The loop halts on THAT rather than pretending to enforce - but only
#       when EVERY configured ceiling is dead, because the two axes have
#       separate coverage: codex reports tokens and no cost, claude can report
#       a cost with no usage dict. A cost-reporting adapter still enforces
#       max_cost_usd even though its token ceiling is beyond saving.
#   [agent] budget_usd is a different knob: adapter-internal, claude-sdk only,
#   and it bounds a single turn rather than the run. It is the only genuine
#   per-turn ceiling.
pause_before_pr_merge = false      # opt-in HITL checkpoint before each PR push+merge
progress_log_enabled = true        # JSONL event log at .kstrl/progress.jsonl (R3.2)
# Disabling progress_log_enabled drops progress.jsonl AND events.jsonl. It does
# NOT drop usage accounting: engineer_usage.json is still written per component
# under .kstrl/runs/<run_id>/ so a killed worker's spend still reaches the meter.
keep_worktrees_on_failure = false  # keep failed components' worktrees for post-mortem (R3.3)

# Phase 1 mechanical verification.
[verify]
# test_command, typecheck_command, lint_command default to uv run pytest / mypy / ruff
# Override to your project's commands if different.
check_diff_scope = true
check_bad_patterns = true
dead_code_cleanup = false
dead_code_command = ""             # empty = smart default when dead_code_cleanup is on
mutation_testing = false
mutation_threshold = 50.0
mutation_timeout = 600.0
subprocess_timeout = 300.0
require_self_critique = false      # opt-in: fail Phase 1 if engineer's ## Self-Critique block missing/sparse
self_critique_min_bullets = 3
progress_file_path = ""            # empty = the progress log beside the component's PRD

# Phase 1 policy envelope (R8.1): declarative merge guardrails enforced on
# ARTIFACTS (git diff, uv.lock), never on agent self-report. Opt-in: when
# enabled, a violation fails Phase 1 and blocks the merge. Modifying
# enforcement machinery - the policy file, CI workflows, or the verifier code
# that implements the gates - is a non-overridable halt whenever enabled.
# Set a numeric cap negative to disable it.
[policy]
enabled = false
paths_deny = [".github/workflows/**", "kstrl.toml", "ralph.toml", ".kstrl/**", "**/*.pem", "**/.env*"]
max_files_changed = 40
max_lines_changed = 1500           # machine-generated lockfiles are excluded from the count
deps_allow_new = false             # block new uv.lock packages; L3+ may set true
secret_patterns = ["AKIA[0-9A-Z]{16}", "-----BEGIN (?:RSA |EC )?PRIVATE KEY-----"]
# ADD to the hardcoded enforcement-machinery halt set (CI + policy file +
# kstrl verifier code). Additive only: config can never shrink that set.
enforcement_paths_extra = []
# License gate for newly-added uv.lock deps. Resolved from uv's cache, then
# PyPI. Deny wins over allow. Empty license_allow disables the gate.
license_allow = ["MIT", "MIT-0", "BSD-2-Clause", "BSD-3-Clause", "Apache-2.0", "ISC", "PSF-2.0", "Python-2.0", "Unlicense", "0BSD"]
license_deny_partial = ["GPL", "AGPL", "SSPL", "Commons-Clause", "BUSL", "EUPL"]
license_unresolved = "block"       # block | advisory - what to do when no source resolves a license
license_use_network = true         # false = uv cache only (offline); part of the envelope hash
deploy = false                     # reserved for the R8.7 release gate; stored + hashed, not yet enforced

# Exception inbox (R8.3): one surface for everything awaiting a human -
# policy exceptions, halted runs, unconfirmed merges, budget overruns, autonomy
# demotions. On by default: recording an exception changes no behaviour, and
# what you lose by having it off is the record of a decision you already made.
# Triage with `ks inbox ls|show|approve|reject|snooze|retry`.
[inbox]
enabled = true
open_item_cap = 50                 # open items after which queue intake pauses (R8.6); 0 = unbounded
snooze_hours = 24.0                # default snooze TTL; a snoozed item RETURNS
notify_action_required = true      # notify on action-required items and demotions only

# Continuous intake (R8.6): the local work queue under .kstrl/queue/. Work
# waits here instead of a human firing each run; `ks queue add` enqueues and
# (from PR 2) `ks serve` drains. max_attempts is the retry BOUND - it holds
# even when the failure classifier is wrong, which is the point: a measured
# engineer iteration costs ~$1.70-2.60 first-attempt and $3.99-7.42 on a
# retry, so an unbounded loop is real money. Only infrastructure_error
# failures are ever retried automatically; spec-level failures go to poison/.
[queue]
max_attempts = 3                   # execution attempts per item before poisoning
lease_ttl_seconds = 3600.0         # claim validity; the reaper recovers anything past this

# Continuous-intake daemon (R8.6): `ks serve` drains the queue above, one
# factory run at a time. Only infrastructure failures retry, and only on
# positive evidence - spec failures go to poison/ and wait for a human, because
# a queue that retries spec failures overnight is the most expensive bug this
# repo could ship. daily_budget_usd is the real cap on unattended spend; note
# it can only count cost an adapter REPORTS (the codex adapter reports tokens
# and no cost), so with a cost-blind agent it is unenforceable rather than
# approximate - serve refuses to run in that case unless you set
# allow_uncovered_cost. The unreported spend is deliberately never estimated.
[serve]
poll_interval_seconds = 60.0       # seconds between poll cycles
daily_budget_usd = 0.0             # 0 = no cap; any positive value is a HARD stop
max_consecutive_poison = 3         # poisoned in a row before the queue pauses
caffeinate = true                  # hold caffeinate -i per run (macOS); sleeps between
factory_timeout_seconds = 0.0      # kill a run after this long; 0 = no timeout
allow_uncovered_cost = false       # true = run unattended under an unenforceable budget

# GitHub Issues as the remote inbox (R8.6). An issue carrying queued_label
# becomes a queue item; the verdict comes back as a state label and a comment.
# Polling only - no webhooks, no public endpoint.
#
# WHAT AUTHORIZES WORK, accurately: a stranger can open an issue but cannot
# label it. But applying a label needs the TRIAGE role, not push access, so on
# an org repo a triager who cannot push code can still authorize spend - and any
# Action with `issues: write` can label too. Issue #188 replaces that inherited
# permission with an explicit actor allowlist. What IS enforced today: an issue
# edited AFTER it was labelled is refused, because GitHub lets an issue author
# rewrite the body after a maintainer labelled it.
#
# Remote items ALWAYS stop at the PR regardless of any label or setting.
# Off by default: enabling makes this an outbound poller and a writer of
# public comments, which should never happen because a default changed.
[intake_github]
enabled = false
repo = ""                          # "owner/name"; empty resolves from the checkout
queued_label = "kstrl:queued"      # the trigger; applying it requires write access
label_prefix = "kstrl:"            # state labels written back: running/done/failed/poison
max_items_per_sync = 5             # a label applied to 50 issues must not queue 50 runs
default_priority = 0
comment_on_result = true           # post the verdict back to the source issue
dry_run = false                    # true = poll and log, send no writebacks
timeout_seconds = 60.0

# Across-attempt divergence detector (#265). The retry loop can drive a
# component the wrong way: the review fails, the engineer answers by writing
# more code, the change gets larger, and the reviewer comes back no happier.
# Each turn of that costs a full engineer run. It trips when the change got
# larger at every one of `growth_steps` consecutive failed reviews AND not one
# of the reviewer's blocking findings was retired at any of them. ADVISORY
# first: the size half is exact but the retirement half reconstructs a
# finding's identity from reviewer prose, and that has no measured
# false-positive rate yet. Set mode = "block" once you have seen its output on
# real runs; a blocking trip is overridable with `ks retry`.
[divergence]
mode = "advisory"                  # skip | advisory | block
growth_steps = 2                   # consecutive steps; needs N+1 measured attempts, must be >= 1

# Test-suite adequacy gate (R8.5), Layer 0: reads the diff and changed test
# files - no test execution, no coverage, no mutation tooling. Catches the
# suite getting WEAKER (deleted tests, added skip/xfail, assertions removed)
# and new tests that assert nothing falsifiable. Opt-in and ADVISORY first:
# findings are recorded without failing, so switching it to blocking later
# starts from evidence instead of a guess. With [autonomy] on, Layer 0 blocks
# from L1 up per the roadmap's level table.
[adequacy]
enabled = false
layer0 = "advisory"                # advisory | block
require_strong_oracle = true       # each new test file needs one falsifiable assertion
flag_assertionless_tests = true    # report tests that assert nothing

# Autonomy ladder (R8.2): one ordered level (L1-L4) replaces the scatter of
# independent autonomy flags. The level derives a flag bundle at run start and
# WINS over contradicting flags here (contradictions are logged, not honored).
# Opt-in because L1 is STRICTER than the defaults - it forces the merge gate on.
# Level lives in .kstrl/autonomy.json; change it with `ks autonomy promote`
# (needs a human ack) or `ks autonomy demote`. Entry thresholds are UNMEASURED
# placeholders - run `ks autonomy replay` before trusting them.
[autonomy]
# `enabled` and the two demote_on_* switches below are REFUSED unless written
# as an unquoted true or false, unlike every other key in this file. `= "false"`
# is a string, and every non-empty string reads as true; a typo that arms the
# ladder or one of its revocation switches is worse than one that disarms it.
enabled = false
max_level = 4                      # hard local ceiling: refuse to run above this level
# Advisory first: an inbox item always; demotion only when true.
demote_on_calibration_regression = false
demote_on_health_breach = false

# Phase 1 approved fixtures (R7.2): PRD-defined input/output pairs run as an
# oracle independent of agent-authored tests. Opt-in: fixtures execute
# PRD-supplied commands (no shell) and import PRD-named modules (in a
# scrubbed-env subprocess), so the operator must enable them explicitly.
[fixtures]
enabled = false
snapshot_on_success = true         # save passing outputs for cross-run regression comparison
snapshot_dir = ".kstrl/snapshots"  # relative = against the repo root, not the worktree
timeout = 30.0                     # seconds per fixture subprocess

# Phase 2.5 security review (independent adversarial pass focused on vulns).
[security]
mode = "skip"                      # skip | advisory | hard
fail_threshold = "high"            # critical | high | medium | low (hard mode only)
timeout_seconds = 600.0
# agent_cmd / agent_type / model: leave blank to inherit from [agent].
# Categories mapped to OWASP Top 10 + CWE via SECURITY_CATEGORY_MAP in security.py.

# Phase 3 cross-component contract testing.
[contract]
mode = "tier"                      # tier | final | skip
test_command = "uv run pytest"
timeout = 600.0

# Phase 0 feedforward (computational structural scan; no LLM).
[feedforward]
enabled = true
module_map = true
public_interfaces = true
dependency_graph = true
conventions = true
max_context_tokens = 4000

# Continuous-learning journal.
[evolution]
enabled = true
journal_path = ".kstrl/evolution.jsonl"
experiments_path = ".kstrl/experiments.tsv"
min_pattern_frequency = 2
lookback_runs = 10
# auto_propose makes a bare `ks evolve` default to generating proposal
# files; NOTHING runs automatically after factory runs - proposals are
# only ever generated by a human typing `ks evolve`.
auto_propose = true
# auto_apply_computational only skips the confirm prompt inside an
# already-typed `ks evolve --apply <ID>`; it never applies anything on
# its own.
auto_apply_computational = false

# Run-milestone notification hooks (R3.2). Shell commands fired at most
# once per run, with KSTRL_NOTIFY_EVENT (run_complete | first_failure |
# merge_pending | inbox_<kind>), KSTRL_NOTIFY_RUN_ID, KSTRL_NOTIFY_PROJECT,
# KSTRL_NOTIFY_COMPONENT and KSTRL_NOTIFY_DETAIL set in their environment.
# on_inbox_item is a separate command on purpose: an R8.3 inbox item is
# usually raised for the same event that already fired on_first_failure,
# so sharing one command would notify twice for one thing.
[notify]
on_complete = ""                   # e.g. "printf '\\a'" for a terminal bell
on_first_failure = ""              # e.g. a curl webhook one-liner
on_inbox_item = ""                 # per R8.3 inbox item kind; opt-in
hook_timeout = 30.0                # seconds before a hook command is killed

# Linear integration (R7.4). Off by default. When enabled, decompose
# creates one Linear project per manifest and one issue per component
# (user stories as a checklist), files non-blocker spec issues into
# Triage, carries the issue identifier in branch names, and adds a
# "Fixes <ID>" trailer to PR bodies so Linear's GitHub integration
# drives status transitions with zero API calls from kstrl. The token
# is read from the env var named by token_env and never stored here.
[linear]
enabled = false
team_id = ""                       # Linear team UUID (required when enabled)
token_env = "KSTRL_LINEAR_TOKEN"   # env var holding the API key / OAuth token
auth_mode = "auto"                 # auto | api_key | oauth
api_url = "https://api.linear.app/graphql"
dry_run = false                    # log mutations instead of sending them
timeout_seconds = 30.0
min_request_interval = 0.5         # client-side throttle (shared rate pool)
