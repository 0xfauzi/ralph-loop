/* kstrl dashboard styles - design pass.
 *
 * System: warm near-black ramp, ONE amber accent, state colors
 * reserved for status. Dense pro-tool register: the screen fills with
 * data (board + activity feed); dead space is a defect. Rhythm:
 * 1-line masthead / board / 1-line panel titles / feed / footer.
 */

Screen {
    background: $background;
}

/* ---- shared chrome (design 2) ------------------------------------------- */
/* Every table wears the board's dress: muted bold headers on the
 * screen background, ONE amber cursor tint, quiet scrollbars. The
 * default Textual chrome (blue cursor, chunky scrollbars) never
 * appears anywhere. */

DataTable {
    background: $background;
}

DataTable > .datatable--header {
    background: $background;
    color: $text-muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $accent 22%;
    color: $foreground;
}

DataTable > .datatable--hover {
    background: $surface;
}

DataTable {
    scrollbar-color: $panel;
    scrollbar-background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

.context-bar {
    dock: top;
    height: 1;
    background: $surface;
    padding: 0 1;
}

.context-bar .context-left {
    width: 1fr;
    content-align: left middle;
}

.context-bar .context-right {
    width: auto;
    content-align: right middle;
    padding: 0 1;
}

/* Forms live in dialog panels (the modal grammar, docked not modal):
 * round accent border with a title, surface body, constrained width -
 * a form is a focused conversation, not a full-screen sprawl. */

.dialog-panel {
    width: 76;
    height: auto;
    max-height: 90%;
    border: round $accent 60%;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
}

.dialog-host {
    align: center middle;
    height: 1fr;
}

/* ---- masthead --------------------------------------------------------- */

#topbar {
    dock: top;
    height: 1;
    background: $surface;
    color: $foreground;
}

#run-header {
    width: 1fr;
    content-align: left middle;
    padding: 0 1;
}

#cost-meter {
    width: auto;
    content-align: right middle;
    padding: 0 2;
}

#safe-mode-banner {
    height: 1;
    background: $warning 18%;
    color: $warning;
    text-style: bold;
    padding: 0 2;
}

#checkpoint-banner {
    height: 1;
    background: $accent 18%;
    color: $accent;
    text-style: bold;
    padding: 0 2;
}

/* Same alert grammar as the safe-mode banner, but height: auto - this
 * one carries a section, a loader message and the input that set it,
 * and a truncated repair instruction is not a repair instruction. It
 * collapses to nothing while the config resolves (display: none).
 * Selected by TYPE, not by id: a screen that mistyped an id would get
 * an unstyled, always-visible bar and no error saying so. */
ConfigProblemBanner {
    display: none;
    height: auto;
    background: $error 18%;
    color: $error;
    text-style: bold;
    padding: 0 2;
}

/* The evolve screen's repaired-journal-write line (#333). Same alert
 * grammar as the banner above it, height: auto because it names a path
 * and a truncated path is not a path, and display: none because it is
 * silent at zero. The colour is set on the Text rather than here, so a
 * mistyped id costs the padding and not the warning. */
#evolve-repairs {
    display: none;
    height: auto;
    padding: 0 2;
}

/* ---- overview board ---------------------------------------------------- */

#component-table {
    height: auto;
    max-height: 45%;
    background: $background;
    padding: 0 1;
    margin-top: 1;
}

/* ---- activity feed ----------------------------------------------------- */

#activity-title {
    height: 2;
    margin-top: 1;
    padding: 0 2;
    color: $text-muted;
    text-style: bold;
    border-bottom: solid $panel;
}

#activity-feed {
    height: 1fr;
    background: $background;
    padding: 0 2;
    scrollbar-color: $panel;
    scrollbar-background: $background;
    scrollbar-size-vertical: 1;
}

/* ---- component detail --------------------------------------------------- */

#component-header {
    dock: top;
    height: 1;
    background: $surface;
    padding: 0 1;
}

#phase-timeline {
    height: 1;
    margin: 1 2 0 2;
}

#findings-title {
    height: 2;
    margin-top: 1;
    padding: 0 2;
    color: $text-muted;
    text-style: bold;
    border-bottom: solid $panel;
}

#findings-table {
    height: auto;
    max-height: 30%;
    background: $background;
    padding: 0 1;
}

#transcript-title {
    height: 2;
    margin-top: 1;
    padding: 0 2;
    color: $text-muted;
    text-style: bold;
    border-bottom: solid $panel;
}

#transcript {
    height: 1fr;
    background: $background;
    padding: 0 2;
    scrollbar-color: $panel;
    scrollbar-background: $background;
    scrollbar-size-vertical: 1;
}

#evidence {
    dock: bottom;
    height: auto;
    max-height: 7;
    padding: 0 2;
    background: $surface;
    color: $text-muted;
}

/* ---- modals ------------------------------------------------------------- */

CheckpointModal {
    align: center middle;
    background: $background 60%;
}

#checkpoint-dialog {
    width: 92%;
    max-width: 110;
    height: 85%;
    border: round $accent 60%;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
}

#checkpoint-question {
    text-style: bold;
    color: $foreground;
}

#checkpoint-summary {
    height: 1;
    margin-bottom: 1;
    color: $text-muted;
}

#checkpoint-body {
    height: 1fr;
    background: $background;
    padding: 1 2;
    scrollbar-color: $panel;
    scrollbar-background: $background;
    scrollbar-size-vertical: 1;
}

#checkpoint-buttons {
    height: 3;
    margin-top: 1;
    align-horizontal: center;
}

#checkpoint-buttons Button {
    margin: 0 1;
    min-width: 16;
    border: none;
    height: 1;
    background: $panel;
    color: $foreground;
    text-style: none;
}

#checkpoint-buttons Button:hover {
    background: $boost;
}

#checkpoint-buttons Button:focus {
    text-style: bold;
}

/* One primary action; secondary paths stay quiet until focused.
 * Color names the consequence, not the chrome. choice-0 is always
 * the affirmative/default option (Approve / Start). */
#checkpoint-buttons #choice-0 {
    background: $accent;
    color: $background;
    text-style: bold;
}

#checkpoint-buttons #choice-1 {
    color: $error;
}

#checkpoint-buttons #choice-2 {
    color: $warning;
}

/* ---- home shell ---------------------------------------------------------- */
/* Control-room layout: 2-line surface header, runs beside the
 * launcher, and the highlighted run's live board filling the rest -
 * the same no-dead-space rule as the overview's activity feed. */

#home-header {
    dock: top;
    height: 3;
    background: $surface;
}

#home-header #safe-mode-chip {
    height: 1;
    padding: 0 1;
}

#home-masthead {
    height: 1;
    padding: 0 1;
}

#home-stats {
    height: 1;
    padding: 0 1;
}

#home-columns {
    height: auto;
    max-height: 45%;
    margin-top: 1;
}

#home-runs-col {
    width: 2fr;
}

#home-commands-col {
    width: 44;
    margin-left: 2;
}

#home-runs-title, #home-commands-title {
    height: 2;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
    border-bottom: solid $panel;
}

#home-runs {
    height: auto;
    background: $background;
}

#home-commands {
    height: auto;
    background: $background;
    border: none;
    padding: 0 1;
}

#home-commands > .option-list--option-highlighted {
    background: $accent 22%;
}

#home-preview-title {
    height: 2;
    margin-top: 1;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
    border-bottom: solid $panel;
}

#home-preview {
    height: 1fr;
    background: $background;
    padding: 0 1;
}

#home-preview-meta {
    height: 1;
    padding: 0 1;
    background: $surface;
}

/* ---- config screen ------------------------------------------------------- */

#config-filter {
    height: 1;
    border: none;
    background: $surface;
    padding: 0 1;
}

#config-title {
    height: 2;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
    border-bottom: solid $panel;
}

#config-table {
    height: 1fr;
    background: $background;
}

#config-hint {
    height: 1;
    padding: 0 1;
}

/* ---- forms + init wizard ------------------------------------------------- */

.form-field {
    height: auto;
    margin-bottom: 1;
}

.form-label {
    width: 14;
    padding: 0 1;
}

.form-field Input {
    width: 1fr;
    height: 1;
    border: none;
    background: $background;
    padding: 0 1;
}

.form-field Select {
    width: 1fr;
    height: 1;
}

.form-field Select > SelectCurrent {
    border: none;
    background: $background;
    height: 1;
    padding: 0 1;
}

.form-hint {
    width: auto;
    padding: 0 1;
}

.path-marker {
    width: 14;
    padding: 0 1;
}

#wizard-form, #wizard-preview, #wizard-result {
    height: auto;
}

/* #261: one line per resolved gate command, and a chained polyglot
   command wraps, so this cannot be `height: 1` - everything after the
   first line renders nowhere. #wizard-errors stays at 1 so the form
   does not shift when an error appears. */
#wizard-detected {
    height: auto;
}

#wizard-errors {
    height: 1;
}

.wizard-buttons {
    height: 3;
    margin-top: 1;
}

.wizard-buttons Button {
    margin: 0 1;
    min-width: 14;
    border: none;
    height: 1;
    background: $panel;
    color: $foreground;
    text-style: none;
}

.wizard-buttons .default-choice {
    background: $accent;
    color: $background;
    text-style: bold;
}

#wizard-plan-title, #wizard-log-title {
    height: 2;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
    border-bottom: solid $panel;
}

#wizard-plan {
    height: auto;
    padding: 0 1;
}

#wizard-log-scroll {
    height: auto;
    max-height: 20;
    background: $background;
    padding: 0 1;
}

#wizard-outcome {
    height: 1;
    padding: 0 1;
}

/* ---- launch forms + retry ------------------------------------------------ */

#retry-title {
    height: 2;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
    border-bottom: solid $panel;
}

#launch-errors {
    height: 1;
}

#retry-table {
    height: 1fr;
    background: $background;
}

#retry-detail {
    height: 6;
    padding: 1 2;
    background: $surface;
}

/* ---- evolve screen ------------------------------------------------------- */

#evolve-tabs {
    height: 1fr;
}

#proposals-split {
    height: 1fr;
}

#proposals-table {
    width: 55%;
    height: 1fr;
    background: $background;
}

#proposal-detail {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: $background;
    border-left: solid $panel;
}

#patterns-table, #trends-table {
    height: 1fr;
    background: $background;
}

/* ---- decompose screen ---------------------------------------------------- */
/* Same register as the component screen: strips are 1 line, panel
 * titles 2 (the border-bottom needs its own row), the transcript
 * fills what remains. */

#decompose-header {
    height: 1;
    padding: 0 1;
}

#attempt-strip {
    height: 1;
    margin-top: 1;
    padding: 0 1;
}

#dag-title, #triage-title {
    height: 2;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
    border-bottom: solid $panel;
}

#dag-table {
    height: auto;
    max-height: 40%;
    background: $background;
}

#issues-strip {
    height: 1;
    margin-top: 1;
    padding: 0 1;
}

#decompose-summary {
    height: 1;
    padding: 0 1;
}

#decompose-transcript-title {
    height: 2;
    padding: 0 1;
    border-bottom: solid $panel;
}

/* ---- spec triage --------------------------------------------------------- */

#triage-banner {
    height: 1;
    padding: 0 1;
}

#triage-table {
    height: 1fr;
    background: $background;
}

#triage-detail {
    height: 6;
    padding: 1 2;
    background: $surface;
}

/* ---- options modal ------------------------------------------------------- */
/* Lean prompt surface for every non-checkpoint request (feature gate,
 * apply/retry confirms). Same chrome family as the checkpoint modal;
 * the accent sits on the REQUEST's default option, which is not
 * always index 0. */

OptionsModal {
    align: center middle;
    background: $background 60%;
}

#options-dialog {
    width: 70%;
    max-width: 90;
    height: auto;
    border: round $accent 60%;
    border-title-color: $accent;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
}

#options-question {
    text-style: bold;
    color: $foreground;
}

#options-buttons {
    height: 3;
    margin-top: 1;
    align-horizontal: center;
}

#options-buttons Button {
    margin: 0 1;
    min-width: 16;
    border: none;
    height: 1;
    background: $panel;
    color: $foreground;
    text-style: none;
}

#options-buttons Button:hover {
    background: $boost;
}

#options-buttons Button:focus {
    text-style: bold;
}

#options-buttons .default-choice {
    background: $accent;
    color: $background;
    text-style: bold;
}

/* ---- quit modal ---------------------------------------------------------- */

QuitModal {
    align: center middle;
    background: $background 60%;
}

#quit-dialog {
    width: 62;
    height: auto;
    border: round $error 60%;
    border-title-color: $error;
    border-title-style: bold;
    background: $surface;
    padding: 1 2;
}

#quit-question {
    text-style: bold;
}

#quit-detail {
    color: $text-muted;
    margin-bottom: 1;
}

#quit-buttons {
    height: 3;
    align-horizontal: center;
}

#quit-buttons Button {
    margin: 0 1;
    min-width: 18;
    border: none;
    height: 1;
    background: $panel;
    color: $foreground;
}

#quit-buttons #stop {
    background: $error 85%;
    color: $background;
    text-style: bold;
}


/* ---- safe-mode panel --------------------------------------------------- */
/* border_title renders ONLY when the container has a border, and without
   these rules the dialog filled the screen titleless. The width bound is
   measured: the nominal body is 189 cells and clipped at 80 columns. */
#safemode-dialog {
    width: 80%;
    max-width: 96;
    height: 70%;
    margin: 2 4;
    padding: 1 2;
    background: $surface;
    border: round $warning;
}

/* 1fr, not a fixed max-height: a scroller taller than its dialog is
   clipped by the dialog while its own max_scroll_y stays 0, so the
   overflow is both invisible AND unreachable. Measured at 80x24 with
   four reasons: 15 content rows, 4 visible, max_scroll_y 0. */
#safemode-scroll {
    height: 1fr;
}

#safemode-body {
    width: 100%;
    height: auto;
}
